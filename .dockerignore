# Keep the build context small. Anything here is NOT sent to the docker daemon.
.git
.gitignore
.github
*.md
!README.md

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# node, just in case someone drops a frontend in here
node_modules/
npm-debug.log*

# local env / secrets
.env
.env.*
!.env.example

# editors / os
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# data dirs people accidentally mount
data/
*.log
*.sqlite
